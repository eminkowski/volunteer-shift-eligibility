{
  "compilerOptions": {
    "module": "es2022",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "target": "esnext",
    "types": ["node"],
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src", "tests", "fixtures"]
}
